# Copia este archivo como .env y completa tus datos. El archivo .env no se sube a Git.
# Deja el wallet descomprimido en la raiz del disco: las rutas con espacios fallan con TNS_ADMIN.
DB_URL=jdbc:oracle:thin:@NOMBREBD_tp?TNS_ADMIN=C:/Wallet_NOMBREBD
DB_USER=ADMIN
DB_PASSWORD=tu_clave_de_oracle
# Minimo 32 caracteres. Debe ser igual en ms-usuarios y ms-foro.
JWT_SECRET=cambia_esta_clave_por_una_de_32_caracteres_o_mas
